FROM pytorch/pytorch:1.12.1-cuda11.3-cudnn8-runtime-22.04

# System deps for audio I/O and rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    fluidsynth libsndfile1 ffmpeg git && \
    rm -rf /var/lib/apt/lists/*

# Python deps
RUN pip install --no-cache-dir -pythonde pip && \
    pip install --no-cache-dir \
      librosa pandas numpy scipy matplotlib \
      soundfile pretty_midi midiutil \
      pypianoroll==0.4.2 opencv-python

WORKDIR /workspace
